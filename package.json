{
  "name": "brand-decision-desk",
  "private": true,
  "version": "1.0.0",
  "description": "A browser-only worksheet for comparing three authored brand directions and recording explicit design decisions.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc -b --force",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "privacy": "node scripts/privacy-check.mjs",
    "check": "npm run test:unit && npm run typecheck && npm run build && npm run privacy",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "24.9.2",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.1",
    "@vitejs/plugin-react": "5.0.4",
    "typescript": "5.9.3",
    "vite": "7.1.12",
    "vitest": "3.2.4"
  }
}
